# ================================================================
# 智能客服系统 - 环境变量配置
# 复制为 .env 后填入真实值
# ================================================================

# ===== LLM 配置（OpenAI 兼容 API，可对接火山方舟 / DeepSeek / 通义等）=====
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-2-1-pro-260915

# ===== Embedding 配置（OpenAI 兼容接口）=====
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_DIM=2560

# ===== 联网搜索（OpenAI Responses API，与 LLM 共用凭证）=====
# 留空则复用 LLM_API_KEY / LLM_BASE_URL
WEB_SEARCH_MODEL=doubao-seed-2-1-pro-260915

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=chat
# 摘要压缩：消息数超过阈值时触发历史摘要
MEMORY_MAX_MESSAGES=20
MEMORY_KEEP_RECENT=6
MEMORY_SUMMARY_MAX_TOKENS=500

# ===== 知识库 =====
VECTOR_STORE_PATH=./data/vector_store
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
# 检索相似度阈余弦阈值，低于该值的结果将被过滤
SIMILARITY_THRESHOLD=0.3

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 允许的跨域来源（逗号分隔），前后端分离部署时使用
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
